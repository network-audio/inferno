
pcm.inferno {
	type inferno
	@args.NAME { type string default "" }
	@args.DEVICE_ID { type string default "" }
	@args.BIND_IP { type string default "" }
	@args.SAMPLE_RATE { type string default "" }
	@args.PROCESS_ID { type string default "" }
	@args.ALT_PORT { type string default "" }
	@args.RX_CHANNELS { type string default "" }
	@args.TX_CHANNELS { type string default "" }
	@args.CLOCK_PATH { type string default "" }
	@args.RX_LATENCY_NS { type string default "" }
	@args.TX_LATENCY_NS { type string default "" }

	# Arguments (e.g. inferno:RX_CHANNELS=8) default to "", which Inferno treats as not set (then the
	# INFERNO_* environment variable or the built-in default applies). Without defaults, ALSA can't list
	# the device (aplay -L).
	# note: too long ALSA device string may not work in some or all apps (noticed in PipeWire)
	# so if you need to change them, better configure all needed settings below
	# and remove corresponding "@args. ..." lines above

	NAME $NAME
	DEVICE_ID $DEVICE_ID
	BIND_IP $BIND_IP
	SAMPLE_RATE $SAMPLE_RATE
	PROCESS_ID $PROCESS_ID
	ALT_PORT $ALT_PORT
	RX_CHANNELS $RX_CHANNELS
	TX_CHANNELS $TX_CHANNELS
	CLOCK_PATH $CLOCK_PATH
	RX_LATENCY_NS $RX_LATENCY_NS
	TX_LATENCY_NS $TX_LATENCY_NS

	hint {
		show on
		description "Inferno ALSA virtual device"
	}
}

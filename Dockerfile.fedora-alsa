FROM fedora:42 AS builder

RUN dnf install -y alsa-lib-devel cargo

WORKDIR /build
COPY . .

ARG BUILD_FLAGS=--release
ARG BUILD_TYPE=release

RUN --mount=type=cache,target=/root/.local/cargo/registry --mount=type=cache,target=/build/target \
    mkdir /out && \
    cargo build $BUILD_FLAGS -p alsa_pcm_inferno && \
    cp target/$BUILD_TYPE/libasound_module_pcm_inferno.so /out/


FROM fedora:42

RUN dnf install -y alsa-lib

# installed like users do (install.sh finds alsa-lib's plugin directory); also tests the installer
COPY install.sh /opt/inferno/
COPY alsa_pcm_inferno/asoundrc /opt/inferno/alsa_pcm_inferno/
COPY os_integration /opt/inferno/os_integration
COPY --from=builder /out/libasound_module_pcm_inferno.so /opt/inferno/
RUN /opt/inferno/install.sh --prebuilt /opt/inferno/libasound_module_pcm_inferno.so
